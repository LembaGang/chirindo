{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence-bundle-verdict/0.10",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "verifier", "bundle_sha256", "mode", "checked_at", "stated", "pointer", "endpoints", "checks", "bindings", "decision", "gate_receipts", "instructions", "payment", "card", "hash_search", "times", "orderings", "flags", "verdict", "limits"],
  "$defs": {
    "state": { "enum": ["BOUND", "MATCHED", "CARRIED-BY-OTHER", "SUPPLIED", "PRESENT", "KEY-ONLY", "KEY-ROTATED-OUT", "SIGNER-ROTATED-OUT", "EXCEEDS", "UNBOUND-OUTSIDE", "WITHHELD", "TRUNCATED", "NOT-FINAL", "UNSUPPORTED-PATH", "NO-PAYMENT", "NOT-EVALUATED", "ABSENT", "FAIL", "DIFFERS", "AFTER-AUTHORIZATION"] },
    "reason": { "type": ["string", "null"] },
    "text": { "type": "string" },
    "address": { "type": ["string", "null"], "pattern": "^0x[0-9a-f]{40}$" }
  },
  "properties": {
    "type": { "const": "evidence-bundle-verdict/0.10" },
    "verifier": { "type": "object", "additionalProperties": false, "required": ["name", "version", "commit"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "commit": { "type": "string" } } },
    "bundle_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "mode": { "enum": ["offline", "online"] },
    "checked_at": { "type": "string" },
    "stated": { "type": "object", "additionalProperties": false, "required": ["authorizer", "tx", "charge"],
      "properties": { "authorizer": { "$ref": "#/$defs/address" }, "tx": { "type": ["string", "null"], "pattern": "^0x[0-9a-f]{64}$" },
        "charge": { "type": ["object", "null"], "additionalProperties": false, "required": ["id", "amount_minor", "currency", "authorized_at", "merchant_order_id", "checkout_ref"],
          "properties": { "id": { "type": "string" }, "amount_minor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "authorized_at": { "type": "string" }, "merchant_order_id": { "type": ["string", "null"] }, "checkout_ref": { "type": ["string", "null"] } } } } },
    "pointer": { "type": ["object", "null"], "additionalProperties": false, "required": ["uri", "stated_entry", "stated_sha256", "fetched_sha256", "status", "detail"],
      "properties": { "uri": { "type": "string" }, "stated_entry": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "stated_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
        "fetched_sha256": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }, "status": { "enum": ["fetched", "match", "mismatch", "unfetchable"] }, "detail": { "$ref": "#/$defs/text" } } },
    "endpoints": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["service", "url", "registrable_domain", "answered", "used"],
      "properties": { "service": { "enum": ["json-rpc", "witness", "jwks", "key-document"] }, "url": { "type": "string" },
        "registrable_domain": { "type": ["string", "null"] }, "answered": { "type": "boolean" }, "used": { "type": "boolean" } } } },
    "checks": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "member", "status", "reason", "detail"],
      "properties": { "id": { "type": "string" }, "member": { "type": ["string", "null"] },
        "status": { "enum": ["PASS", "FAIL", "NOT-EVALUATED"] }, "reason": { "$ref": "#/$defs/reason" }, "detail": { "$ref": "#/$defs/text" } } } },
    "bindings": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["id", "state", "reason", "carrier", "signed_by", "detail"],
      "properties": { "id": { "enum": ["B-LOG", "B-CKP", "B-WIT", "B-PAY", "B-CHAIN", "B-KEY", "B-INS", "B-GRC", "B-CARD"] },
        "state": { "$ref": "#/$defs/state" }, "reason": { "$ref": "#/$defs/reason" },
        "carrier": { "enum": ["eip3009-nonce", "calldata", null] }, "signed_by": { "$ref": "#/$defs/address" }, "detail": { "$ref": "#/$defs/text" } } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["value", "record", "receipt", "refusing_records"],
      "properties": { "value": { "enum": ["allow", "refuse", "not-read"] },
        "record": { "type": ["object", "null"], "additionalProperties": false, "required": ["log", "seq", "event_decision", "event_outcome", "gate_result", "receipt_uid"],
          "properties": { "log": { "type": "string" }, "seq": { "type": "integer", "minimum": 0 }, "event_decision": { "type": ["string", "null"] }, "event_outcome": { "type": ["string", "null"] },
            "gate_result": { "type": ["string", "null"] }, "receipt_uid": { "type": ["string", "null"], "pattern": "^0x[0-9a-f]{64}$" } } },
        "receipt": { "type": ["object", "null"], "additionalProperties": false, "required": ["member", "verdict", "reading"],
          "properties": { "member": { "type": "string" }, "verdict": { "type": ["string", "null"] }, "reading": { "enum": ["permit", "refuse", null] } } },
        "refusing_records": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["log", "seq", "source"],
          "properties": { "log": { "type": "string" }, "seq": { "type": "integer", "minimum": 0 }, "source": { "enum": ["record", "receipt"] } } } } } },
    "gate_receipts": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["member", "uid", "log", "seq", "at_or_before_cited", "cited", "state", "reason", "flags"],
      "properties": { "member": { "type": "string" }, "uid": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }, "log": { "type": ["string", "null"] },
        "seq": { "type": ["integer", "null"], "minimum": 0 }, "at_or_before_cited": { "type": ["boolean", "null"] }, "cited": { "type": "boolean" },
        "state": { "$ref": "#/$defs/state" }, "reason": { "$ref": "#/$defs/reason" }, "flags": { "type": "array", "items": { "type": "string" } } } } },
    "instructions": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["member", "cited", "state", "exceeded", "reason", "uses", "records_without_arguments", "card_limits"],
      "properties": { "member": { "type": "string" }, "cited": { "type": "boolean" }, "state": { "$ref": "#/$defs/state" },
        "exceeded": { "type": "array", "items": { "enum": ["chain_id", "asset", "payees", "max_amount", "valid_from", "valid_until", "agent_kid", "max_uses", "budget",
          "currency", "max_total_minor", "max_unit_price_minor", "merchants", "items", "categories", "refundable_only", "service_window", "locations"] } },
        "reason": { "$ref": "#/$defs/reason" }, "uses": { "type": "integer", "minimum": 0 }, "records_without_arguments": { "type": "integer", "minimum": 0 },
        "card_limits": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["limit", "result", "reason"],
          "properties": { "limit": { "enum": ["currency", "max_total_minor", "max_unit_price_minor", "merchants", "items", "categories", "refundable_only", "service_window", "locations"] },
            "result": { "enum": ["inside", "outside", "not-declared", "not-evaluated"] }, "reason": { "$ref": "#/$defs/reason" } } } } } } },
    "payment": { "type": "object", "additionalProperties": false, "required": ["connected", "reason", "payer", "movements", "as_supplied"],
      "properties": { "connected": { "type": "boolean" }, "reason": { "$ref": "#/$defs/reason" }, "payer": { "$ref": "#/$defs/address" }, "as_supplied": { "type": "boolean" },
        "movements": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["asset", "amount", "payee", "source", "log_index"],
          "properties": { "asset": { "type": "string" }, "amount": { "type": "string" }, "payee": { "type": "string" },
            "source": { "enum": ["counted", "log"] }, "log_index": { "type": ["integer", "null"], "minimum": 0 } } } } } },
    "card": { "type": ["object", "null"], "additionalProperties": false, "required": ["order", "matches", "witness_received_at", "authorized_at", "before_authorization"],
      "properties": {
        "order": { "type": ["object", "null"], "additionalProperties": false, "required": ["merchant_id", "merchant_order_id", "checkout_ref", "currency", "total_minor", "items_sum_minor", "item_count"],
          "properties": { "merchant_id": { "type": "string" }, "merchant_order_id": { "type": ["string", "null"] }, "checkout_ref": { "type": ["string", "null"] }, "currency": { "type": "string" },
            "total_minor": { "type": "string" }, "items_sum_minor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }, "item_count": { "type": "integer", "minimum": 1 } } },
        "matches": { "type": "object", "additionalProperties": false, "required": ["amount", "currency", "merchant_order_id", "checkout_ref"],
          "properties": { "amount": { "type": ["boolean", "null"] }, "currency": { "type": ["boolean", "null"] }, "merchant_order_id": { "type": ["boolean", "null"] }, "checkout_ref": { "type": ["boolean", "null"] } } },
        "witness_received_at": { "type": ["string", "null"] }, "authorized_at": { "type": "string" }, "before_authorization": { "type": ["boolean", "null"] } } },
    "hash_search": { "type": ["object", "null"], "additionalProperties": false, "required": ["fields", "forms", "matches"],
      "properties": { "fields": { "type": "array", "items": { "type": "string" } }, "forms": { "type": "array", "items": { "enum": ["raw-32-bytes", "hex-text"] } },
        "matches": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["field", "form", "offset"],
          "properties": { "field": { "type": "string" }, "form": { "enum": ["raw-32-bytes", "hex-text"] }, "offset": { "type": ["integer", "null"], "minimum": 0 } } } } } },
    "times": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["what", "value", "clock", "as_supplied"],
      "properties": { "what": { "type": "string" }, "value": { "type": "string" },
        "clock": { "enum": ["principal", "issuer", "operator", "headless-oracle", "block-producer", "payer", "processor"] }, "as_supplied": { "type": "boolean" } } } },
    "orderings": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["earlier", "later", "rests_on", "status"],
      "properties": { "earlier": { "type": "string" }, "later": { "type": "string" }, "rests_on": { "type": "string" },
        "status": { "enum": ["SHOWN", "NOT-EVALUATED"] } } } },
    "flags": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "detail"],
      "properties": { "code": { "type": "string" }, "detail": { "$ref": "#/$defs/text" } } } },
    "verdict": { "type": "object", "additionalProperties": false, "required": ["code", "text", "rule", "reason", "gaps"],
      "properties": { "code": { "enum": ["FAILS", "DOES-NOT-CONNECT", "PAYMENT-NOT-VERIFIED", "VERIFIES-OUTSIDE-INSTRUCTION", "VERIFIES", "VERIFIES-WITH-GAPS",
          "DOES-NOT-MATCH-CHARGE", "OUTSIDE-INSTRUCTION", "RECORDED-BEFORE-CHARGE", "RECORDED-WITH-GAPS"] },
        "text": { "type": "string" }, "rule": { "enum": ["V1", "V2", "V3", "V4", "V5", "V6", "C1", "C2", "C3", "C4", "C5", "C6"] }, "reason": { "$ref": "#/$defs/reason" },
        "gaps": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["binding", "state", "reason"],
          "properties": { "binding": { "type": "string" }, "state": { "$ref": "#/$defs/state" }, "reason": { "$ref": "#/$defs/reason" } } } } } },
    "limits": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"],
      "properties": { "id": { "pattern": "^L([1-9]|1[0-9]|2[0-5])$", "type": "string" }, "text": { "type": "string" } } } }
  }
}
